{
  "name": "ichiro-kpr-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Cinematic interactive archive experience for Ichiro: Legacy of Rebirth.",
  "scripts": {
    "start": "node server.js",
    "check": "node tools/production-readiness-check.js",
    "test:integrity": "node tools/repository-integrity-check.js",
    "test:assets": "node tools/asset-governance-check.js",
    "test:content": "node --no-warnings tools/final-asset-check.mjs",
    "test:content:final": "node --no-warnings tools/final-asset-check.mjs --strict",
    "assets:generate:soundscapes": "node tools/generate-dossier-soundscapes.mjs",
    "assets:generate:motion": "node tools/generate-dossier-motion.mjs",
    "assets:derive:stills": "python tools/derive-dossier-stills.py",
    "test:runtime": "node tools/runtime-governance-check.js",
    "test:visual": "node tools/visual-cohesion-check.js",
    "test:dossiers": "node --no-warnings tools/dossier-protocol-check.js",
    "test:a11y": "node tools/accessibility-contract-check.js",
    "test:delivery": "node tools/secure-delivery-check.js && node tools/supply-chain-check.js && node tools/release-manifest.js",
    "test:observability": "node tools/observability-contract-check.js",
    "test:gold": "node tools/gold-release-check.js",
    "build:static": "node tools/build-static-site.js",
    "test:static": "npm run build:static && node tools/static-distribution-check.js",
    "test:soak": "node tools/soak-proof.js",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "test:e2e": "node tools/e2e-proof.js",
    "test:e2e:matrix": "node tools/browser-device-matrix.js",
    "test:e2e:static": "npm run build:static && node tools/static-browser-proof.js",
    "test:veil": "node tools/veil-portal-fusion-check.js",
    "test:entry": "node tools/aaa-entry-sequence-check.js",
    "test:transmission": "node tools/transmission-premium-check.js",
    "test:cinema": "node tools/cinematic-cohesion-check.js",
    "test:recovery": "node tools/recovery-master-check.js",
    "test": "npm run test:integrity && npm run test:assets && npm run test:content && npm run test:runtime && npm run test:visual && npm run test:dossiers && npm run test:a11y && npm run test:delivery && npm run test:observability && npm run test:gold && npm run test:static && npm run check && npm run test:veil && npm run test:entry && npm run test:transmission && npm run test:cinema && npm run test:recovery"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "puppeteer-core": "25.1.0"
  }
}
